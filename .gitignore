# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## Build generated
build/
DerivedData/

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/

## Other
*.moved-aside
*.xccheckout
*.xcscmblueprint

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts


# macOS Finder metadata
.DS_Store
**/.DS_Store

# Signing material and anything else that must never leave this machine.
*.p12
*.mobileprovision
Athan Utility/signing certificate.p12

# App Store Connect contact details: personal address, phone, email and the
# review demo account. fastlane still reads these locally; they are just not
# tracked.
fastlane/metadata/review_information/
fastlane/metadata/trade_representative_contact_information/
fastlane/.env

# Stray Xcode export logs.
Athan Utility/Athan Utility 2021-01-19 14-22-14/

# fastlane/gym writes its export here; regenerated on every release run.
Athan Utility.app/
Athan Utility (Mac).pkg
*.dSYM.zip

# Local editor/tool config.
.claude/

# fastlane setup stays private; only the screenshots are published.
fastlane/*
!fastlane/screenshots/
!fastlane/screenshots_mac/
