# This file contains the fastlane.tools configuration
# https://docs.fastlane.tools

# update_fastlane

# Personal App Store Connect account (Athan Utility, Cookie Shark, etc.).
# NOTE: This is intentionally the PERSONAL key — distinct from the Serene Studios
# key (N67S79PJK6) used by Cup Guide. Do not swap these.
API_KEY_ID      = "77D7SYW2X8"
API_ISSUER_ID   = "69a6de83-37c3-47e3-e053-5b8c7c11a4d1"
API_KEY_PATH    = "/Users/omaralejel/.appstoreconnect/private_keys/AuthKey_77D7SYW2X8.p8"

default_platform(:ios)

platform :ios do

  desc "Upload metadata (descriptions, keywords, screenshots) to App Store Connect — no binary"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )
    deliver(
      api_key:                  api_key,
      app_identifier:           "com.omaralejel.Athan-Utility",
      skip_binary_upload:       true,
      skip_screenshots:         false,
      skip_app_version_update:  false,
      force:                    true,
      run_precheck_before_submit: false,
      submit_for_review:        false,
      metadata_path:            "./fastlane/metadata"
    )
  end

  desc "Build and upload a new release to App Store Connect (TestFlight / review)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )
    increment_build_number(xcodeproj: "Athan Utility.xcodeproj")
    build_app(
      workspace:      "Athan Utility.xcworkspace",
      scheme:         "Athan Utility",
      configuration:  "Release",
      export_method:  "app-store",
      clean:          true,
      xcargs:         "-authenticationKeyPath \"#{API_KEY_PATH}\" -authenticationKeyID #{API_KEY_ID} -authenticationKeyIssuerID #{API_ISSUER_ID} -allowProvisioningUpdates",
      export_options: {
        method:            "app-store",
        teamID:            "DL7989H5XT",
        signingStyle:      "automatic",
        stripSwiftSymbols: true
      }
    )
    upload_to_app_store(
      api_key:                  api_key,
      app_identifier:           "com.omaralejel.Athan-Utility",
      skip_metadata:            false,
      skip_screenshots:         true,
      metadata_path:            "./fastlane/metadata",
      submit_for_review:        true,
      automatic_release:        false,
      force:                    true,
      run_precheck_before_submit: false,
      submission_information:   { export_compliance_uses_encryption: false }
    )
  end

  desc "Submit the already-uploaded build for review (no rebuild) — clears export compliance"
  lane :finalize do
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )
    deliver(
      api_key:                  api_key,
      app_identifier:           "com.omaralejel.Athan-Utility",
      skip_binary_upload:       true,
      skip_metadata:            true,
      skip_screenshots:         true,
      submit_for_review:        true,
      automatic_release:        false,
      force:                    true,
      run_precheck_before_submit: false,
      submission_information:   { export_compliance_uses_encryption: false }
    )
  end

  desc "Upload an already-built IPA + localized metadata and submit for review"
  lane :submit_ipa do |options|
    api_key = app_store_connect_api_key(
      key_id:       API_KEY_ID,
      issuer_id:    API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )
    upload_to_app_store(
      api_key:                  api_key,
      app_identifier:           "com.omaralejel.Athan-Utility",
      ipa:                      options[:ipa],
      skip_metadata:            false,
      skip_screenshots:         true,
      metadata_path:            "./fastlane/metadata",
      submit_for_review:        true,
      automatic_release:        false,
      force:                    true,
      run_precheck_before_submit: false
    )
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(workspace: "Athan Utility.xcworkspace", scheme: "Athan Utility")
    upload_to_app_store(skip_binary_upload: true, skip_metadata: true)
  end

end
