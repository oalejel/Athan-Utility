# Devices to screenshot on (must exist in the installed Simulator runtime)
devices([
  "iPhone 17 Pro"
])

# Languages / locales — each maps to a .lproj in the app.
# One entry per App Store metadata locale, so no listing falls back to English
# screenshots. es-MX and de-DE resolve to the app's es/de .lproj.
languages([
  "en-US",
  "ar-SA",
  "de-DE",
  "es-ES",
  "es-MX",
  "fr-FR",
  "id",
  "ms",
  "tr",
  "zh-Hans"
])
# Scheme that runs the UI tests
scheme("Athan Utility")

# Where the resulting screenshots are stored
output_directory("./fastlane/screenshots")

# Clear previously generated screenshots before creating new ones
clear_previous_screenshots(true)

# Take screenshots one simulator at a time (more reliable)
concurrent_simulators(false)
