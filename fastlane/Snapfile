# Devices to screenshot on (must exist in the installed Simulator runtime)
devices([
  "iPhone 17 Pro"
])

# Languages / locales — each maps to a .lproj in the app.
# One entry per App Store metadata locale, so no listing falls back to English
# screenshots. es-MX and de-DE resolve to the app's es/de .lproj.
languages([
  "en-US",
  "ar-SA",
  "de-DE",
  "es-ES",
  "es-MX",
  "fr-FR",
  "id",
  "ms",
  "tr",
  "zh-Hans"
])
# Scheme that runs the UI tests
scheme("Athan Utility")

# Where the resulting screenshots are stored
output_directory("./fastlane/screenshots")

# Clear previously generated screenshots before creating new ones
clear_previous_screenshots(true)

# Take screenshots one simulator at a time (more reliable)
concurrent_simulators(false)

# Clean, identical status-bar furniture in every locale's set instead of whatever the
# simulator happened to have.
#
# NOTE: --time is deliberately absent. This simulator runtime rejects it —
# `simctl status_bar <udid> override --time <anything>` fails with
# NSPOSIXErrorDomain code 22 (Invalid argument), while the battery/wifi flags in the same
# call succeed. Including it makes the WHOLE override fail, so the status bar keeps the
# host machine's clock. The app's own times are unaffected: they render in the captured
# city's zone against the pinned 19:00 (see SnapshotSupport), so the prayer list, the
# highlighted prayer and the countdown all agree with each other.
override_status_bar(true)
override_status_bar_arguments("--dataNetwork wifi --wifiMode active --wifiBars 3 --cellularMode notSupported --batteryState charged --batteryLevel 100")

# Put the simulator itself into the captured language/region, so system-drawn UI
# (permission alerts, share sheets, date pickers) matches the app rather than staying
# English underneath a localized app.
localize_simulator(true)
